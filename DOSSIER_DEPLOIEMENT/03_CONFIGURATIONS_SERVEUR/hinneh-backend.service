[Unit]
Description=Hinneh Education FastAPI Backend (hinneh-education.ci)
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/hinneh-education.ci/backend
EnvironmentFile=/var/www/hinneh-education.ci/backend/.env
ExecStart=/var/www/hinneh-education.ci/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
